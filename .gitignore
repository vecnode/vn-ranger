# Build output
/target
/target-crt
**/*.rs.bk

# Editor and OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local scratch: a developer's own notes or rule packs, never committed
/scratch/
*.local.toml

# Scratch profiles for a local test run: the data directory a harness writes, and the
# throwaway profile a report is written into. They hold this machine's facts - process
# paths, listeners, packages - so they never belong in a commit.
/.tmp-ci/
/.tmp-probe/
/.tmp-probe2/

# A commit message written to a file, so a long one survives the shell
/.git-commit-msg.txt

# Release asset verification downloads
/.release-check/
/.ci-*.log

# Soak measurement artifacts, reproducible from the documented method
/.soak.csv
/.soak.log
/.soak-summary.txt
/.soak-temp/
